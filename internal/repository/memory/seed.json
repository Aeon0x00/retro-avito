      "linkedId": "item_1",
      "status": "open",
      "createdAt": "30.10.2026 10:15",
      "replies": [
        {
          "id": "rep_1",
          "versionId": "v1",
          "authorId": "user_boris",
          "authorName": "Борис",
          "text": "На раннем саратовском Москвиче А1 до 1978 года надпись «Сделано в СССР» отлита крупным рубленным шрифтом, а крепление днища идёт через винт с плоским шлицем. На фото из объявления позднее днище — лучше отказаться от покупки, если ищете ранний А1.",
          "sourceUrl": "https://rcforum-example.ru/tantal-a1-guide",
          "sellerDisclosure": "Помогаю без продажи (нет своей полки и объявлений)",
          "createdAt": "30.10.2026 10:42",
          "helpfulByAuthor": true,
          "clarifications": [
            {
              "id": "cl_1",
              "authorName": "Алексей",
              "text": "Спасибо! А капот у раннего выпуска всегда открывается?"
            }
          ]
        }
      ]
    },
